# Auth (NextAuth v5)
AUTH_URL=http://localhost:3001
AUTH_SECRET=your-secret-here

# Twitter OAuth (optional — Demo Login works without this)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Google OAuth (optional — Demo Login works without this)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform Wallet Secret (hybrid key split)
PLATFORM_WALLET_SECRET=your-platform-secret-here
